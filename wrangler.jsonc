{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manual",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    {
      "pattern": "manual.prismoment.com",
      "custom_domain": true
    }
  ]
}
